<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console with the coloured level (config/CustomDebugConfig), same look as the hub -->
    <conversionRule conversionWord="customLevel" class="io.github.b077as.smartjp.config.CustomDebugConfig" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %customLevel(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file with gzip archives. Its own name, because the hub writes logs/smartjp.log and both can run from the same folder.
         The desktop app has no console to look at, so the file matters most there: it sets smartjp.log-dir to logs/ inside its data folder
         (SmartJpApplication), because the folder it is started from is the install folder, which is not the place for logs. -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${smartjp.log-dir:-logs}/smartjp.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${smartjp.log-dir:-logs}/smartjp.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- The level of our own code comes from application.properties (logging.level.io.github.b077as.smartjp). -->
    <logger name="org.springframework.web" level="INFO" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
